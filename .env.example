# ------- Banco de dados (o MESMO banco usado pelo bot) -------
DATABASE_URL=

# ------- Discord OAuth2 (Discord Developer Portal > OAuth2) -------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Deve bater EXATAMENTE com uma "Redirect URI" cadastrada no Discord
# Ex.: https://seu-site.vercel.app/api/auth/discord/callback
DISCORD_REDIRECT_URI=

# ------- Sessão (string longa e aleatória — ex.: openssl rand -hex 32) -------
# O site usa sessão própria (cookie HttpOnly assinado com JWT via "jose"),
# não usa NextAuth — por isso a variável é SESSION_SECRET.
SESSION_SECRET=

# ------- WebAuthn / Passkey -------
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# ------- Comunicação com o bot (endpoint interno) -------
BOT_API_URL=
# Precisa ser IDÊNTICO ao INTERNAL_API_SECRET configurado no bot
BOT_API_SECRET=
